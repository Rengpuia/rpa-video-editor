          "tint": 0
        }
      },
      "keyframes": [
        { "id": "kf_1", "timeOffset": 0.0, "property": "scale", "value": 1.0, "easing": "easeInOut" },
        { "id": "kf_2", "timeOffset": 5.0, "property": "scale", "value": 1.25, "easing": "easeInOut" },
        { "id": "kf_3", "timeOffset": 11.0, "property": "scale", "value": 1.25, "easing": "easeInOut" },
        { "id": "kf_4", "timeOffset": 15.0, "property": "scale", "value": 1.0, "easing": "easeInOut" }
      ],
      "telemetry": [
        { "time": 0.5, "x": 0.20, "y": 0.25, "type": "mousemove" },
