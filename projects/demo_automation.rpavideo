{
  "title": "RPA Studio Showcase & Tutorial",
  "duration": 25,
  "projectSettings": {
    "name": "1080p FHD (16:9)",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "backgroundColor": "#0f1115"
  },
  "tracks": [
    { "id": 4, "name": "Track 4 (Overlays)", "type": "overlay", "visible": true, "locked": false, "muted": false },
    { "id": 3, "name": "Track 3 (Subtitles)", "type": "caption", "visible": true, "locked": false, "muted": false },
    { "id": 2, "name": "Track 2 (Video)", "type": "video", "visible": true, "locked": false, "muted": false },
    { "id": 1, "name": "Track 1 (Audio)", "type": "audio", "visible": true, "locked": false, "muted": false }
  ],
  "clips": [
    {
      "id": "clip_demo_screen",
      "title": "Automated Invoice Processing.mp4",
      "type": "video",
      "trackId": 2,
      "startTime": 0.0,
      "duration": 22.0,
      "sourceUrl": null,
      "scale": 1.0,
      "scaleX": 1.0,
      "scaleY": 1.0,
      "aspectRatioLocked": true,
      "opacity": 1.0,
      "volume": 1.0,
      "hasAudio": true,
      "transitionIn": "fade",
      "transitionInDuration": 0.8,
      "transitionOut": "fade",
      "transitionOutDuration": 0.8,
