{
  "name": "rpa-video-editor",
  "version": "2.0.0",
  "description": "RPA Video Editor - Cleanroom Open-Source Studio Video Editing Suite",
  "main": "main.js",
  "bin": {
    "rpa-mcp": "./mcp_server.js"
  },
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "start:server": "node server/server.js",
    "mcp": "node mcp_server.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir",
    "build:native": "powershell -ExecutionPolicy Bypass -File ./build_native_desktop.ps1",
    "build:installer": "powershell -ExecutionPolicy Bypass -File ./build_installer.ps1",
    "test": "node --check client/src/app.js && node --check client/src/compositor.js && node --check client/src/timeline.js && node --check client/src/recorder.js && node --check server/server.js && node --check server/mcp_handler.js && node --check mcp_server.js && node --check main.js && node --check preload.js"
  },
  "build": {
    "appId": "com.rpa.videoeditor",
    "productName": "RPA Video Editor",
    "copyright": "Copyright © 2026 K Vanlalrengpuia",
    "directories": {
      "output": "exports"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "client/favicon.ico",
      "artifactName": "RPA-Video-Editor-${version}-${target}.${ext}",
      "legalTrademarks": "Open Source (MIT License)"
    },
    "portable": {
      "artifactName": "RPA-Video-Editor-v${version}-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RPA Video Editor Pro",
      "artifactName": "RPA-Video-Editor-v${version}-Setup.exe"
    },
    "files": [
      "client/**/*",
      "server/**/*",
      "main.js",
      "preload.js",
      "mcp_server.js",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "keywords": [
    "video-editor",
    "screen-recorder",
    "cleanroom",
    "open-source",
    "timeline",
    "studio",
    "mcp",
    "model-context-protocol",
    "electron",
    "desktop-app"
  ],
  "author": "K Vanlalrengpuia <rengakhiangte@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rengpuia/rpa-video-editor.git"
  }
}
